[
  {
    "velocity": 0.18,
    "text": "まったく進まない"
  },
  {
    "velocity": 0.18,
    "text": "人が多すぎて動けない"
  },
  {
    "velocity": 0.18,
    "text": "止まったまま"
  },
  {
    "velocity": 0.18,
    "text": "列がぜんぜん動かないんだけど、何が起きてるの"
  },
  {
    "velocity": 0.18,
    "text": "出口の手前で完全に足止めを食らっています。"
  },
  {
    "velocity": 0.18,
    "text": "すし詰め"
  },
  {
    "velocity": 0.18,
    "text": "前に行きたいのに一歩も出せない"
  },
  {
    "velocity": 0.18,
    "text": "ほぼ停止"
  },
  {
    "velocity": 0.18,
    "text": "退場に時間かかりすぎ、まだ席の近くから動けてない"
  },
  {
    "velocity": 0.18,
    "text": "人だかりで通路がふさがっていて、少しも前に進めませんでした。"
  },
  {
    "velocity": 0.18,
    "text": "動く気配ゼロ"
  },
  {
    "velocity": 0.18,
    "text": "ぎゅうぎゅう詰めで、進むのはほんのわずかずつ"
  },
  {
    "velocity": 0.18,
    "text": "めちゃくちゃ混んでる、全然動かん"
  },
  {
    "velocity": 0.18,
    "text": "ちょびっと進んで長いこと止まる、のくり返し"
  },
  {
    "velocity": 0.18,
    "text": "これは無理、どこにも行けない"
  },
  {
    "velocity": 0.18,
    "text": "混雑がひどく、列はほぼ動いていない状況です。"
  },
  {
    "velocity": 0.18,
    "text": "団子状態"
  },
  {
    "velocity": 0.18,
    "text": "押し合いへし合いで前に出られない"
  },
  {
    "velocity": 0.18,
    "text": "ずーっと立ちっぱなし、進んでる実感がない"
  },
  {
    "velocity": 0.18,
    "text": "牛より遅い"
  },
  {
    "velocity": 0.18,
    "text": "改札の前が人であふれてて、さっきからほとんど動いてない"
  },
  {
    "velocity": 0.18,
    "text": "大渋滞"
  },
  {
    "velocity": 0.18,
    "text": "詰まってて動けません"
  },
  {
    "velocity": 0.18,
    "text": "足の踏み場もないほどの混みようで、列はじりじりとしか進みませんでした。"
  },
  {
    "velocity": 0.18,
    "text": "永遠に着かない気がしてきた、全然動かないから"
  },
  {
    "velocity": 0.54,
    "text": "ゆっくり"
  },
  {
    "velocity": 0.54,
    "text": "混んでて遅い"
  },
  {
    "velocity": 0.54,
    "text": "人が多めで歩くのに時間がかかる"
  },
  {
    "velocity": 0.54,
    "text": "のろのろ進んでる"
  },
  {
    "velocity": 0.54,
    "text": "流れてはいるんだけど、ゆっくりだなあ"
  },
  {
    "velocity": 0.54,
    "text": "やや混み合っており、歩行速度は遅めです。"
  },
  {
    "velocity": 0.54,
    "text": "前の人たちがゆっくりで追い越せない"
  },
  {
    "velocity": 0.54,
    "text": "ちょっと歩きづらいくらいの人混み"
  },
  {
    "velocity": 0.54,
    "text": "とろとろ歩き"
  },
  {
    "velocity": 0.54,
    "text": "休日なので人出が多く、普段より歩くのに時間がかかりました。"
  },
  {
    "velocity": 0.54,
    "text": "ペース遅め"
  },
  {
    "velocity": 0.54,
    "text": "混んでて自分の速さで歩けない"
  },
  {
    "velocity": 0.54,
    "text": "ゆっくりめの流れに乗ってる"
  },
  {
    "velocity": 0.54,
    "text": "人が多くてもたつく"
  },
  {
    "velocity": 0.54,
    "text": "立ち止まりはしないけど、だいぶのんびり"
  },
  {
    "velocity": 0.54,
    "text": "通路が混んできたため、流れがゆっくりになっています。"
  },
  {
    "velocity": 0.54,
    "text": "うーん、遅いな"
  },
  {
    "velocity": 0.54,
    "text": "人の間をぬって歩くから時間かかる"
  },
  {
    "velocity": 0.54,
    "text": "思ったより混んでて、のんびりペース"
  },
  {
    "velocity": 0.54,
    "text": "そろそろと進む"
  },
  {
    "velocity": 0.54,
    "text": "荷物の多い人がたくさんいて、みんなゆっくりめ"
  },
  {
    "velocity": 0.54,
    "text": "進んではいるものの、速さはいまひとつです。"
  },
  {
    "velocity": 0.54,
    "text": "じれったい遅さ"
  },
  {
    "velocity": 0.54,
    "text": "ぼちぼち混んでて歩みが遅い"
  },
  {
    "velocity": 0.54,
    "text": "前がゆっくりだから合わせて歩いてる"
  },
  {
    "velocity": 0.90,
    "text": "普通に歩ける"
  },
  {
    "velocity": 0.90,
    "text": "いつも通り"
  },
  {
    "velocity": 0.90,
    "text": "特に混んでない"
  },
  {
    "velocity": 0.90,
    "text": "ふだんのペース"
  },
  {
    "velocity": 0.90,
    "text": "混み具合はふつうです。"
  },
  {
    "velocity": 0.90,
    "text": "通常の人通り"
  },
  {
    "velocity": 0.90,
    "text": "いつもと変わらず歩けてる"
  },
  {
    "velocity": 0.90,
    "text": "特別空いても混んでもいない"
  },
  {
    "velocity": 0.90,
    "text": "普通の速さ"
  },
  {
    "velocity": 0.90,
    "text": "人出は平常どおりで、いつもの時間で歩けました。"
  },
  {
    "velocity": 0.90,
    "text": "まあ普通"
  },
  {
    "velocity": 0.90,
    "text": "何事もなくいつものように駅まで"
  },
  {
    "velocity": 0.90,
    "text": "平均的"
  },
  {
    "velocity": 0.90,
    "text": "普段どおりの歩きやすさ"
  },
  {
    "velocity": 0.90,
    "text": "いつもの調子"
  },
  {
    "velocity": 0.90,
    "text": "通路の状況は通常と変わりありません。"
  },
  {
    "velocity": 0.90,
    "text": "特に変わったところのない人の流れ"
  },
  {
    "velocity": 0.90,
    "text": "ふつうのペースで歩いてます"
  },
  {
    "velocity": 0.90,
    "text": "毎度おなじみの人通り"
  },
  {
    "velocity": 0.90,
    "text": "遅くも速くもない"
  },
  {
    "velocity": 0.90,
    "text": "いつもの道をいつもの感じで"
  },
  {
    "velocity": 0.90,
    "text": "人はそれなりだけど普通に歩ける"
  },
  {
    "velocity": 0.90,
    "text": "通常"
  },
  {
    "velocity": 0.90,
    "text": "今日もふつうだった"
  },
  {
    "velocity": 0.90,
    "text": "混雑もなく、標準的なペースで移動できています。"
  },
  {
    "velocity": 1.26,
    "text": "スムーズに歩ける"
  },
  {
    "velocity": 1.26,
    "text": "ちょっと速め"
  },
  {
    "velocity": 1.26,
    "text": "空いてて歩きやすい"
  },
  {
    "velocity": 1.26,
    "text": "早歩き気味"
  },
  {
    "velocity": 1.26,
    "text": "いつもより少し早い"
  },
  {
    "velocity": 1.26,
    "text": "人が少なくて、やや速く歩けています。"
  },
  {
    "velocity": 1.26,
    "text": "すいすい"
  },
  {
    "velocity": 1.26,
    "text": "流れがいい"
  },
  {
    "velocity": 1.26,
    "text": "少し急ぎ足で"
  },
  {
    "velocity": 1.26,
    "text": "混んでないのでテンポよく進めました。"
  },
  {
    "velocity": 1.26,
    "text": "わりと速い"
  },
  {
    "velocity": 1.26,
    "text": "思ったよりスムーズ"
  },
  {
    "velocity": 1.26,
    "text": "やや空いてる"
  },
  {
    "velocity": 1.26,
    "text": "気持ち早めに歩いてる"
  },
  {
    "velocity": 1.26,
    "text": "前が空いてるから軽く早歩き"
  },
  {
    "velocity": 1.26,
    "text": "通路は比較的すいていて、流れはやや速めです。"
  },
  {
    "velocity": 1.26,
    "text": "さくさく進む"
  },
  {
    "velocity": 1.26,
    "text": "人が少なくて助かる、ちょっと早く着きそう"
  },
  {
    "velocity": 1.26,
    "text": "軽やかに歩ける"
  },
  {
    "velocity": 1.26,
    "text": "すんなり"
  },
  {
    "velocity": 1.26,
    "text": "みんな少し早歩き"
  },
  {
    "velocity": 1.26,
    "text": "空いてきて歩くのが楽になった、ペースも上がってる"
  },
  {
    "velocity": 1.26,
    "text": "少しだけ速い流れ"
  },
  {
    "velocity": 1.26,
    "text": "快調に進んでる"
  },
  {
    "velocity": 1.26,
    "text": "朝のうちは人が少なめで、軽い早歩きで移動できました。"
  },
  {
    "velocity": 1.62,
    "text": "すごく速い"
  },
  {
    "velocity": 1.62,
    "text": "誰もいないから走って帰った"
  },
  {
    "velocity": 1.62,
    "text": "走る"
  },
  {
    "velocity": 1.62,
    "text": "がらがらの道を全力ダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "全力で走ってる"
  },
  {
    "velocity": 1.62,
    "text": "小走り"
  },
  {
    "velocity": 1.62,
    "text": "人が全くおらず、非常に速く歩けました。"
  },
  {
    "velocity": 1.62,
    "text": "めっちゃ空いてる、爆速で着いた"
  },
  {
    "velocity": 1.62,
    "text": "みんな走ってる"
  },
  {
    "velocity": 1.62,
    "text": "ものすごい速さで駆けていく"
  },
  {
    "velocity": 1.62,
    "text": "人のいない通路を駆け抜ける"
  },
  {
    "velocity": 1.62,
    "text": "超スピード"
  },
  {
    "velocity": 1.62,
    "text": "電車に間に合わせるために全力でダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "通路は無人に近く、皆さま駆け足で通行されています。"
  },
  {
    "velocity": 1.62,
    "text": "すっからかんで歩き放題、めちゃ速い"
  },
  {
    "velocity": 1.62,
    "text": "急ぎすぎて息があがる"
  },
  {
    "velocity": 1.62,
    "text": "走らないと間に合わない！"
  },
  {
    "velocity": 1.62,
    "text": "一気に駆け抜けた"
  },
  {
    "velocity": 1.62,
    "text": "誰ともぶつからない、全速前進"
  },
  {
    "velocity": 1.62,
    "text": "空きすぎてて笑う、一瞬で通り抜けた"
  },
  {
    "velocity": 1.62,
    "text": "周りの人の歩きが速すぎて小走りでついていく"
  },
  {
    "velocity": 1.62,
    "text": "駆け足で階段を上がる"
  },
  {
    "velocity": 1.62,
    "text": "人影なしの通路を一気に駆け抜け"
  },
  {
    "velocity": 1.62,
    "text": "超ダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "深夜で人通りが途絶えており、あっという間に駅まで走り抜けました。"
  },
  {
    "velocity": null,
    "text": "パン食べたい"
  },
  {
    "velocity": null,
    "text": "宿題終わらない"
  },
  {
    "velocity": null,
    "text": "うどん"
  },
  {
    "velocity": null,
    "text": "今日は空が青い"
  },
  {
    "velocity": null,
    "text": "野球の試合、延長戦までもつれこみました。"
  },
  {
    "velocity": null,
    "text": "部屋の電球が切れた"
  },
  {
    "velocity": null,
    "text": "新しい手帳を買った"
  },
  {
    "velocity": null,
    "text": "コーヒー飲みすぎて眠れない"
  },
  {
    "velocity": null,
    "text": "英語のスピーチ原稿、まだ覚えられてない"
  },
  {
    "velocity": null,
    "text": "チョコレート"
  },
  {
    "velocity": null,
    "text": "この映画の音楽がすごく好き"
  },
  {
    "velocity": null,
    "text": "明日はお弁当つくらないと"
  },
  {
    "velocity": null,
    "text": "鍋の季節がやってきました。"
  },
  {
    "velocity": null,
    "text": "財布忘れた"
  },
  {
    "velocity": null,
    "text": "うちの猫が段ボールから出てこない"
  },
  {
    "velocity": null,
    "text": "サッカーの練習で膝すりむいた"
  },
  {
    "velocity": null,
    "text": "数学の証明問題が解けてうれしい"
  },
  {
    "velocity": null,
    "text": "洗剤買い忘れた"
  },
  {
    "velocity": null,
    "text": "お世話になっております。資料を添付いたしますのでご確認ください。"
  },
  {
    "velocity": null,
    "text": "暑い"
  },
  {
    "velocity": null,
    "text": "ピザのチーズが伸びすぎて食べにくい"
  },
  {
    "velocity": null,
    "text": "誕生日プレゼント何にしよう"
  },
  {
    "velocity": null,
