[
  {
    "velocity": 0.18,
    "text": "全然進まん"
  },
  {
    "velocity": 0.18,
    "text": "花火終わって駅まで向かってるけど、さっきからほとんど位置が変わってない気がする"
  },
  {
    "velocity": 0.18,
    "text": "牛歩"
  },
  {
    "velocity": 0.18,
    "text": "改札前が人で埋まっていて、ほとんど前に進めない状況です。"
  },
  {
    "velocity": 0.18,
    "text": "え、これ動いてる？？ってレベル"
  },
  {
    "velocity": 0.18,
    "text": "初詣の参道、一歩進んでは止まり、の繰り返しでした。"
  },
  {
    "velocity": 0.18,
    "text": "すし詰めすぎて足元見えない"
  },
  {
    "velocity": 0.18,
    "text": "ライブ終わりの規制退場、出口までが果てしなく遠い…じりじりとしか進まない"
  },
  {
    "velocity": 0.18,
    "text": "人の壁"
  },
  {
    "velocity": 0.18,
    "text": "休日の人混みなめてた。前の人の背中しか見えないし、ほぼ立ち止まってる"
  },
  {
    "velocity": 0.18,
    "text": "通路が完全に詰まっており、係員の方が誘導していますが列はわずかずつしか動いていません。"
  },
  {
    "velocity": 0.18,
    "text": "亀より遅いかもしれん"
  },
  {
    "velocity": 0.18,
    "text": "歩くというより押し流されてるだけ。しかもめっちゃ遅い"
  },
  {
    "velocity": 0.18,
    "text": "乗り換えにとんでもなく時間かかった、普段ならすぐなのに"
  },
  {
    "velocity": 0.18,
    "text": "ちょっとずつ、ほんとにちょっとずつ"
  },
  {
    "velocity": 0.18,
    "text": "階段の手前で大渋滞"
  },
  {
    "velocity": 0.18,
    "text": "もうずっとこのへんにいる。景色が変わらない"
  },
  {
    "velocity": 0.18,
    "text": "祭りの屋台通り、ベビーカー押してる人とか大変そう…自分もすり足でしか進めてない"
  },
  {
    "velocity": 0.18,
    "text": "ぎゅうぎゅうで身動きとれないんだが"
  },
  {
    "velocity": 0.18,
    "text": "入場ゲート前は大変混み合っており、ほぼ停止に近い状態が続いています。"
  },
  {
    "velocity": 0.18,
    "text": "動かない"
  },
  {
    "velocity": 0.18,
    "text": "完全に詰まってる"
  },
  {
    "velocity": 0.18,
    "text": "一歩も前に出られない時間のほうが長い"
  },
  {
    "velocity": 0.18,
    "text": "押すな押すなの大混雑で、列はほぼ止まったままです。"
  },
  {
    "velocity": 0.18,
    "text": "やばい、人多すぎて全く進まないんだけど"
  },
  {
    "velocity": 0.18,
    "text": "立ち往生"
  },
  {
    "velocity": 0.18,
    "text": "出口が見えてるのに全然たどり着けない"
  },
  {
    "velocity": 0.18,
    "text": "前も後ろも横も人、人、人。足を出すスペースがない"
  },
  {
    "velocity": 0.18,
    "text": "退場の列、さっきから微動だにしてない気がする"
  },
  {
    "velocity": 0.18,
    "text": "半歩ずつ"
  },
  {
    "velocity": 0.18,
    "text": "規制がかかっているようで、ホームへ上がる階段の前で長いこと足止めされています。"
  },
  {
    "velocity": 0.18,
    "text": "満員電車がそのまま通路になったみたいな密度で、ほぼ止まってる"
  },
  {
    "velocity": 0.18,
    "text": "じりっ…じりっ…って感じ"
  },
  {
    "velocity": 0.18,
    "text": "進んだと思ったらまた止まる。これの無限ループ"
  },
  {
    "velocity": 0.18,
    "text": "おしくらまんじゅう状態"
  },
  {
    "velocity": 0.18,
    "text": "こんなに動かない人混みは初めてかもしれない"
  },
  {
    "velocity": 0.18,
    "text": "入場待ちの列が長蛇で、先頭がまったく見えません。少し進んではしばらく止まる、という具合です。"
  },
  {
    "velocity": 0.18,
    "text": "身動きとれず"
  },
  {
    "velocity": 0.18,
    "text": "圧がすごい、そして進まない"
  },
  {
    "velocity": 0.18,
    "text": "歩いてるというより立ってる時間のほうが圧倒的に長い"
  },
  {
    "velocity": 0.18,
    "text": "超ノロノロ"
  },
  {
    "velocity": 0.18,
    "text": "子どもが潰されそうで怖い、ほとんど動けないし"
  },
  {
    "velocity": 0.18,
    "text": "橋の上で完全に止まった"
  },
  {
    "velocity": 0.18,
    "text": "カタツムリのほうが速い説"
  },
  {
    "velocity": 0.18,
    "text": "通路がパンク状態"
  },
  {
    "velocity": 0.18,
    "text": "人波にのまれて、ほんの少しずつしか前に行けませんでした。"
  },
  {
    "velocity": 0.18,
    "text": "もはや行列じゃなくて塊"
  },
  {
    "velocity": 0.18,
    "text": "詰まりすぎ"
  },
  {
    "velocity": 0.18,
    "text": "帰りたいのに帰れない、駅の入口で入場規制かかってて列がびくともしない"
  },
  {
    "velocity": 0.18,
    "text": "足踏みしてるだけ"
  },
  {
    "velocity": 0.18,
    "text": "こりゃしばらく動かんな"
  },
  {
    "velocity": 0.18,
    "text": "ぎっしり"
  },
  {
    "velocity": 0.18,
    "text": "会場を出るだけでひと苦労でした。出口付近は人が密集していて、すり足で少しずつ進むのがやっと。"
  },
  {
    "velocity": 0.18,
    "text": "止まってる時間長すぎて足が棒"
  },
  {
    "velocity": 0.18,
    "text": "激混みで前に進めません"
  },
  {
    "velocity": 0.18,
    "text": "ミリ単位でしか動いてない"
  },
  {
    "velocity": 0.18,
    "text": "え、まだここ？さっきと同じ看板の前なんだけど"
  },
  {
    "velocity": 0.18,
    "text": "肩と肩がぶつかる距離で、歩幅なんてあったもんじゃない"
  },
  {
    "velocity": 0.18,
    "text": "超渋滞"
  },
  {
    "velocity": 0.18,
    "text": "現在、通路内は著しく混雑しており、歩行が困難な状況となっております。"
  },
  {
    "velocity": 0.18,
    "text": "びくともしない"
  },
  {
    "velocity": 0.18,
    "text": "前の人のかかと踏みそうで足が出せない"
  },
  {
    "velocity": 0.18,
    "text": "ずっと同じ場所に立たされてる"
  },
  {
    "velocity": 0.18,
    "text": "人が多すぎて進むどころか押し戻されてる"
  },
  {
    "velocity": 0.18,
    "text": "全然前いかん"
  },
  {
    "velocity": 0.18,
    "text": "通路全体が人で埋め尽くされ、列はほとんど動く気配がありません。"
  },
  {
    "velocity": 0.18,
    "text": "止まってる"
  },
  {
    "velocity": 0.18,
    "text": "これ今日中に帰れる？ってくらい動かない"
  },
  {
    "velocity": 0.18,
    "text": "階段の途中で動けなくなった、上も下も人でびっしり"
  },
  {
    "velocity": 0.18,
    "text": "芋洗い状態"
  },
  {
    "velocity": 0.18,
    "text": "ノロノロどころじゃない、ほぼ静止"
  },
  {
    "velocity": 0.18,
    "text": "出口に人が殺到していて、すり足でわずかに進むのが精一杯でした。"
  },
  {
    "velocity": 0.18,
    "text": "詰んだ"
  },
  {
    "velocity": 0.18,
    "text": "息苦しいくらいの人混みで、足がまったく前に出ない"
  },
  {
    "velocity": 0.18,
    "text": "待機列かと思ったらこれ通路なんだよな…動かなすぎる"
  },
  {
    "velocity": 0.18,
    "text": "カメの歩み"
  },
  {
    "velocity": 0.18,
    "text": "前方で何かあったのか、列がぴたりと止まってしまいました。"
  },
  {
    "velocity": 0.18,
    "text": "押されるがまま、ほんのちょっとずつ"
  },
  {
    "velocity": 0.18,
    "text": "ひたすら立ち尽くす"
  },
  {
    "velocity": 0.18,
    "text": "混みすぎて歩くという行為が成立してない"
  },
  {
    "velocity": 0.54,
    "text": "のろのろ"
  },
  {
    "velocity": 0.54,
    "text": "人多くてなかなか自分のペースで歩けない"
  },
  {
    "velocity": 0.54,
    "text": "日曜の観光地、止まりはしないけどだいぶゆっくりめ"
  },
  {
    "velocity": 0.54,
    "text": "前のグループが横に広がってて抜かせない〜"
  },
  {
    "velocity": 0.54,
    "text": "混んでるなあ"
  },
  {
    "velocity": 0.54,
    "text": "通路はやや混雑しており、通常より時間がかかる見込みです。"
  },
  {
    "velocity": 0.54,
    "text": "流れてはいるけど遅い。"
  },
  {
    "velocity": 0.54,
    "text": "紅葉シーズンはどこもこんな感じなんだろうね、人の後ろをとぼとぼついていくしかない"
  },
  {
    "velocity": 0.54,
    "text": "傘さしてる人多くて歩きづらい、ペース落ちる"
  },
  {
    "velocity": 0.54,
    "text": "朝の乗り換え通路、今日はいつもより詰まってる気がする"
  },
  {
    "velocity": 0.54,
    "text": "ゆっくりゆっくり"
  },
  {
    "velocity": 0.54,
    "text": "商店街ぶらぶら。人が多いので自然と歩くのが遅くなる"
  },
  {
    "velocity": 0.54,
    "text": "エスカレーター待ちの列が伸びてて、その手前から歩みがゆっくりになってます"
  },
  {
    "velocity": 0.54,
    "text": "だらだら進む列"
  },
  {
    "velocity": 0.54,
    "text": "まあ動いてるだけマシか"
  },
  {
    "velocity": 0.54,
    "text": "観光客が多くて思うように歩けませんでしたが、立ち止まるほどではなかったです。"
  },
  {
    "velocity": 0.54,
    "text": "微妙に混んでて微妙に遅い、いちばんイライラするやつ"
  },
  {
    "velocity": 0.54,
    "text": "小股でちょこちょこ歩いてる"
  },
  {
    "velocity": 0.54,
    "text": "イベント会場から駅への道、ぞろぞろと人の波。急ぎたいけど無理そう"
  },
  {
    "velocity": 0.54,
    "text": "追い越せそうで追い越せない"
  },
  {
    "velocity": 0.54,
    "text": "ちょっと混んでて歩きにくい"
  },
  {
    "velocity": 0.54,
    "text": "のんびりペース"
  },
  {
    "velocity": 0.54,
    "text": "ゆっくりだけど動いてはいる"
  },
  {
    "velocity": 0.54,
    "text": "人が多いので、いつもより時間に余裕を持ったほうがよさそうです。"
  },
  {
    "velocity": 0.54,
    "text": "トロトロ"
  },
  {
    "velocity": 0.54,
    "text": "前の人に合わせるしかない"
  },
  {
    "velocity": 0.54,
    "text": "抜かしたいけど抜かせない微妙な混み具合"
  },
  {
    "velocity": 0.54,
    "text": "だいぶ人増えてきた、歩くの遅くなってきたな"
  },
  {
    "velocity": 0.54,
    "text": "流れが鈍い"
  },
  {
    "velocity": 0.54,
    "text": "休日の商店街はやっぱり人が多く、ゆっくりとしか歩けませんでした。"
  },
  {
    "velocity": 0.54,
    "text": "遅め"
  },
  {
    "velocity": 0.54,
    "text": "スマホ見ながら歩いてる人多くてペース上がらん"
  },
  {
    "velocity": 0.54,
    "text": "ぞろぞろ"
  },
  {
    "velocity": 0.54,
    "text": "混雑気味"
  },
  {
    "velocity": 0.54,
    "text": "キャリーケース引いてる人が多くて、流れがゆったりしてる"
  },
  {
    "velocity": 0.54,
    "text": "止まらないだけありがたいけど、遅い"
  },
  {
    "velocity": 0.54,
    "text": "夕方になって人通りが増え、歩みはやや遅くなっています。"
  },
  {
    "velocity": 0.54,
    "text": "ちんたら歩く集団の後ろについてしまった"
  },
  {
    "velocity": 0.54,
    "text": "詰まり気味"
  },
  {
    "velocity": 0.54,
    "text": "いつもよりだいぶ時間かかりそう"
  },
  {
    "velocity": 0.54,
    "text": "人をよけながらだから、どうしても遅くなる"
  },
  {
    "velocity": 0.54,
    "text": "屋台を見ながらみんなゆっくり歩いてる"
  },
  {
    "velocity": 0.54,
    "text": "もたもた"
  },
  {
    "velocity": 0.54,
    "text": "ホームに降りる階段がちょっと渋滞してる"
  },
  {
    "velocity": 0.54,
    "text": "歩けるには歩けるけどストレスたまる遅さ"
  },
  {
    "velocity": 0.54,
    "text": "お土産屋さんの前でみんな立ち止まるから流れが悪い"
  },
  {
    "velocity": 0.54,
    "text": "混んできたので歩幅を小さめに"
  },
  {
    "velocity": 0.54,
    "text": "やや混雑。ゆっくりと流れています。"
  },
  {
    "velocity": 0.54,
    "text": "思うように進まないなあ"
  },
  {
    "velocity": 0.54,
    "text": "スローペース"
  },
  {
    "velocity": 0.54,
    "text": "団体さんの後ろになっちゃって、しばらくゆっくり歩くことに"
  },
  {
    "velocity": 0.54,
    "text": "まあまあ混んでる。急いでる人にはつらいかも"
  },
  {
    "velocity": 0.54,
    "text": "流れに逆らえないので、のろのろついていく"
  },
  {
    "velocity": 0.54,
    "text": "人混みでペースダウン"
  },
  {
    "velocity": 0.54,
    "text": "改札に向かう列が少し滞っていて、普段より歩くのに時間がかかりました。"
  },
  {
    "velocity": 0.54,
    "text": "遅いけど、止まるほどじゃない"
  },
  {
    "velocity": 0.54,
    "text": "ゆるゆる進む"
  },
  {
    "velocity": 0.54,
    "text": "買い物客でにぎわっていて、すいすいとはいかない感じ"
  },
  {
    "velocity": 0.54,
    "text": "混んでて歩調が合わない"
  },
  {
    "velocity": 0.54,
    "text": "じわじわ人が増えてきて、気づけばだいぶゆっくり"
  },
  {
    "velocity": 0.54,
    "text": "遅い"
  },
  {
    "velocity": 0.54,
    "text": "人が多くてゆっくりめ"
  },
  {
    "velocity": 0.54,
    "text": "テンポ悪いなあ"
  },
  {
    "velocity": 0.54,
    "text": "前がつかえててスピード出せない"
  },
  {
    "velocity": 0.54,
    "text": "だらだらと人の列が続く"
  },
  {
    "velocity": 0.54,
    "text": "歩道が狭くてすれ違うたびにペースが落ちる"
  },
  {
    "velocity": 0.54,
    "text": "人通りが多く、やや歩きづらい状態です。"
  },
  {
    "velocity": 0.54,
    "text": "ゆっくりめに流れてる"
  },
  {
    "velocity": 0.54,
    "text": "急いでるのに前が遅くてもどかしい"
  },
  {
    "velocity": 0.54,
    "text": "混んでるけど一応流れてる"
  },
  {
    "velocity": 0.54,
    "text": "のそのそ"
  },
  {
    "velocity": 0.54,
    "text": "カップルと家族連れが多くて、全体的にゆったりした歩み"
  },
  {
    "velocity": 0.54,
    "text": "思ったより人いて、歩くのに時間かかってる"
  },
  {
    "velocity": 0.54,
    "text": "普段よりワンテンポ遅い"
  },
  {
    "velocity": 0.54,
    "text": "ちょい混み"
  },
  {
    "velocity": 0.54,
    "text": "通路はやや込み合っており、ゆっくりとした流れになっています。"
  },
  {
    "velocity": 0.54,
    "text": "ペースが上がらない"
  },
  {
    "velocity": 0.54,
    "text": "人をかき分けるほどじゃないけど、スッとは歩けない"
  },
  {
    "velocity": 0.54,
    "text": "ダラダラ歩き"
  },
  {
    "velocity": 0.54,
    "text": "雨で足元が悪いのもあって、みんな慎重にゆっくり歩いてる"
  },
  {
    "velocity": 0.90,
    "text": "ふつうに歩けてる"
  },
  {
    "velocity": 0.90,
    "text": "特に混んでもないし空いてもない"
  },
  {
    "velocity": 0.90,
    "text": "いつも通りの駅前"
  },
  {
    "velocity": 0.90,
    "text": "人はそこそこいるけど、歩く分には問題なし。"
  },
  {
    "velocity": 0.90,
    "text": "平常運転"
  },
  {
    "velocity": 0.90,
    "text": "お昼すぎの地下街、ほどよい人通りでストレスなく歩けました。"
  },
  {
    "velocity": 0.90,
    "text": "普通"
  },
  {
    "velocity": 0.90,
    "text": "思ったより混んでなくてよかった、まあまあのペースで駅ついた"
  },
  {
    "velocity": 0.90,
    "text": "可もなく不可もなくって感じの人出"
  },
  {
    "velocity": 0.90,
    "text": "通路の流れは落ち着いており、通常どおり通行できます。"
  },
  {
    "velocity": 0.90,
    "text": "平日の夕方ってだいたいこんなもんだよね"
  },
  {
    "velocity": 0.90,
    "text": "周りに合わせて、遅すぎず急ぎすぎず"
  },
  {
    "velocity": 0.90,
    "text": "混雑は解消されたみたい。普通に流れてる"
  },
  {
    "velocity": 0.90,
    "text": "いつものペースで改札まで"
  },
  {
    "velocity": 0.90,
    "text": "人の流れに乗ってそのまま歩いてたら着いた"
  },
  {
    "velocity": 0.90,
    "text": "適度ににぎわってる"
  },
  {
    "velocity": 0.90,
    "text": "会場周辺は現在目立った混雑はなく、ふだんと変わらない様子です。"
  },
  {
    "velocity": 0.90,
    "text": "それなりに人いるな〜と思いつつ、別に詰まることもなく"
  },
  {
    "velocity": 0.90,
    "text": "散歩にちょうどいいくらいの人通り"
  },
  {
    "velocity": 0.90,
    "text": "特筆することのない普通の帰り道。"
  },
  {
    "velocity": 0.90,
    "text": "通常通り"
  },
  {
    "velocity": 0.90,
    "text": "いつもと同じ"
  },
  {
    "velocity": 0.90,
    "text": "普通に歩いて普通に着いた"
  },
  {
    "velocity": 0.90,
    "text": "混雑なし、かといってガラガラでもなく"
  },
  {
    "velocity": 0.90,
    "text": "特に問題なく歩けています。"
  },
  {
    "velocity": 0.90,
    "text": "ほどほど"
  },
  {
    "velocity": 0.90,
    "text": "まあこんなもんでしょ"
  },
  {
    "velocity": 0.90,
    "text": "人通りはいつもどおり"
  },
  {
    "velocity": 0.90,
    "text": "歩きやすくも歩きにくくもない"
  },
  {
    "velocity": 0.90,
    "text": "標準的な人出で、通行に支障はありません。"
  },
  {
    "velocity": 0.90,
    "text": "ふつー"
  },
  {
    "velocity": 0.90,
    "text": "普段と変わらない通勤路"
  },
  {
    "velocity": 0.90,
    "text": "立ち止まることもなく、急ぐこともなく"
  },
  {
    "velocity": 0.90,
    "text": "並の混み具合"
  },
  {
    "velocity": 0.90,
    "text": "いたって平常"
  },
  {
    "velocity": 0.90,
    "text": "人はいるけど気にならない程度"
  },
  {
    "velocity": 0.90,
    "text": "今日も変わらずいつものペース"
  },
  {
    "velocity": 0.90,
    "text": "人の流れは普段どおりで、ふつうに歩ける"
  },
  {
    "velocity": 0.90,
    "text": "想定どおりの時間で駅に到着しました。"
  },
  {
    "velocity": 0.90,
    "text": "ちょうどいい感じの人出だった"
  },
  {
    "velocity": 0.90,
    "text": "マイペースで歩ける"
  },
  {
    "velocity": 0.90,
    "text": "ごく普通の週末のにぎわい、といったところでしょうか。"
  },
  {
    "velocity": 0.90,
    "text": "混んでるってほどでもない"
  },
  {
    "velocity": 0.90,
    "text": "自然なペース"
  },
  {
    "velocity": 0.90,
    "text": "行きも帰りも特に変わったことなし、いつもの歩き"
  },
  {
    "velocity": 0.90,
    "text": "そこそこ"
  },
  {
    "velocity": 0.90,
    "text": "ストレスなく歩けるふつうの人通り"
  },
  {
    "velocity": 0.90,
    "text": "構内の流れは平常どおりです。"
  },
  {
    "velocity": 0.90,
    "text": "とくに早くも遅くもなく"
  },
  {
    "velocity": 0.90,
    "text": "いつもこのくらいだよね、この時間"
  },
  {
    "velocity": 0.90,
    "text": "安定の普通さ"
  },
  {
    "velocity": 0.90,
    "text": "人波に合わせて普通に歩く"
  },
  {
    "velocity": 0.90,
    "text": "昼休みのオフィス街、例によっていつもの感じ"
  },
  {
    "velocity": 0.90,
    "text": "混雑具合は平均的"
  },
  {
    "velocity": 0.90,
    "text": "特に待つこともなく、かといって急かされることもなく歩けました。"
  },
  {
    "velocity": 0.90,
    "text": "中くらい"
  },
  {
    "velocity": 0.90,
    "text": "通常ペースで移動中"
  },
  {
    "velocity": 0.90,
    "text": "ほどよい"
  },
  {
    "velocity": 0.90,
    "text": "毎日こんなもん"
  },
  {
    "velocity": 0.90,
    "text": "現在のところ、歩行者の流れに大きな変化は見られません。"
  },
  {
    "velocity": 0.90,
    "text": "いつもの感じ"
  },
  {
    "velocity": 0.90,
    "text": "普通の速さで歩いてる"
  },
  {
    "velocity": 0.90,
    "text": "別に混んでない、普通"
  },
  {
    "velocity": 0.90,
    "text": "変わりなし"
  },
  {
    "velocity": 0.90,
    "text": "特に言うことなし、いつも通り歩けた"
  },
  {
    "velocity": 0.90,
    "text": "通行はふだんどおりです。"
  },
  {
    "velocity": 0.90,
    "text": "ごくふつう"
  },
  {
    "velocity": 0.90,
    "text": "混雑というほどの人出ではなく、通常の速さで歩けました。"
  },
  {
    "velocity": 0.90,
    "text": "今日の駅、いつも通りすぎて書くことない"
  },
  {
    "velocity": 0.90,
    "text": "並"
  },
  {
    "velocity": 0.90,
    "text": "人の量もペースもいつもと一緒"
  },
  {
    "velocity": 0.90,
    "text": "可もなく不可もなし"
  },
  {
    "velocity": 0.90,
    "text": "平日昼間のよくある人通り"
  },
  {
    "velocity": 0.90,
    "text": "ふつうにてくてく"
  },
  {
    "velocity": 0.90,
    "text": "遅れることも早まることもなく、予定どおり到着。"
  },
  {
    "velocity": 0.90,
    "text": "まあ普通かな"
  },
  {
    "velocity": 0.90,
    "text": "いつもの時間にいつもの速さで"
  },
  {
    "velocity": 0.90,
    "text": "特段の混雑は発生しておらず、平常の流れです。"
  },
  {
    "velocity": 0.90,
    "text": "通常運転"
  },
  {
    "velocity": 0.90,
    "text": "周りと同じくらいの普通のペース"
  },
  {
    "velocity": 1.26,
    "text": "わりとスイスイ"
  },
  {
    "velocity": 1.26,
    "text": "今日は人少なめで歩きやすい"
  },
  {
    "velocity": 1.26,
    "text": "空いてるからちょっと早歩き"
  },
  {
    "velocity": 1.26,
    "text": "いつもより早く着きそう"
  },
  {
    "velocity": 1.26,
    "text": "午前中の並木道、人もまばらで足取り軽く進めました。"
  },
  {
    "velocity": 1.26,
    "text": "流れいいね"
  },
  {
    "velocity": 1.26,
    "text": "電車の時間が近いのでみんな少し急ぎ足"
  },
  {
    "velocity": 1.26,
    "text": "通路は比較的空いており、スムーズにご通行いただけます。"
  },
  {
    "velocity": 1.26,
    "text": "思ってたよりサクサク進む"
  },
  {
    "velocity": 1.26,
    "text": "雨だからか人が少ない。おかげで快調"
  },
  {
    "velocity": 1.26,
    "text": "軽快"
  },
  {
    "velocity": 1.26,
    "text": "前が開けてきたのでペース上げた"
  },
  {
    "velocity": 1.26,
    "text": "乗り換え余裕だった、通路すいてて助かる"
  },
  {
    "velocity": 1.26,
    "text": "朝早く出て正解。参道もすんなり歩ける"
  },
  {
    "velocity": 1.26,
    "text": "やや速め"
  },
  {
    "velocity": 1.26,
    "text": "人の間をするっと抜けていける程度には空いてる"
  },
  {
    "velocity": 1.26,
    "text": "テンポよく歩けて気持ちいい"
  },
  {
    "velocity": 1.26,
    "text": "開場直後だったので人も少なく、会場まではすたすたと歩いて行けました。"
  },
  {
    "velocity": 1.26,
    "text": "ちょい早歩きで間に合いそう"
  },
  {
    "velocity": 1.26,
    "text": "混雑のピークは過ぎたようで、流れがだいぶ速くなってきました"
  },
  {
    "velocity": 1.26,
    "text": "スムーズ"
  },
  {
    "velocity": 1.26,
    "text": "ちょっと早足"
  },
  {
    "velocity": 1.26,
    "text": "今日は歩きやすいな"
  },
  {
    "velocity": 1.26,
    "text": "すいすい進める"
  },
  {
    "velocity": 1.26,
    "text": "人が少なめで、わりと早く駅に着きました。"
  },
  {
    "velocity": 1.26,
    "text": "いいペース"
  },
  {
    "velocity": 1.26,
    "text": "少しだけ急ぎ気味"
  },
  {
    "velocity": 1.26,
    "text": "サクサク"
  },
  {
    "velocity": 1.26,
    "text": "空いてきた"
  },
  {
    "velocity": 1.26,
    "text": "心なしかみんな歩くのが速い"
  },
  {
    "velocity": 1.26,
    "text": "流れが良く、いつもより少し早く到着できそうです。"
  },
  {
    "velocity": 1.26,
    "text": "やや早歩き"
  },
  {
    "velocity": 1.26,
    "text": "すんなり通れた"
  },
  {
    "velocity": 1.26,
    "text": "混雑がひいて歩きやすくなった"
  },
  {
    "velocity": 1.26,
    "text": "足取り軽め"
  },
  {
    "velocity": 1.26,
    "text": "前に人があまりいないので気持ち速めに歩いてる"
  },
  {
    "velocity": 1.26,
    "text": "ちょっと急いでるので早歩き中"
  },
  {
    "velocity": 1.26,
    "text": "比較的スムーズに流れています。"
  },
  {
    "velocity": 1.26,
    "text": "思ったより早く抜けられた"
  },
  {
    "velocity": 1.26,
    "text": "すたすた"
  },
  {
    "velocity": 1.26,
    "text": "隙間が多いからどんどん前に行ける"
  },
  {
    "velocity": 1.26,
    "text": "ピーク時間を外したおかげか、歩道は空いていて気持ちよく歩けました。"
  },
  {
    "velocity": 1.26,
    "text": "追い越しも楽"
  },
  {
    "velocity": 1.26,
    "text": "テンポ速め"
  },
  {
    "velocity": 1.26,
    "text": "いつもよりちょっと速いかも"
  },
  {
    "velocity": 1.26,
    "text": "人がばらけてきて、歩きやすさが戻ってきた"
  },
  {
    "velocity": 1.26,
    "text": "とんとん拍子で改札まで"
  },
  {
    "velocity": 1.26,
    "text": "余裕あるけど、なんとなく早歩きになる"
  },
  {
    "velocity": 1.26,
    "text": "朝の空気が気持ちよくて自然と歩くのが速くなる"
  },
  {
    "velocity": 1.26,
    "text": "通路は空き気味で、いつもより少し早く歩けています。"
  },
  {
    "velocity": 1.26,
    "text": "少し空いてる時間帯"
  },
  {
    "velocity": 1.26,
    "text": "きびきび"
  },
  {
    "velocity": 1.26,
    "text": "みんな通勤モードで少しだけ急いでる"
  },
  {
    "velocity": 1.26,
    "text": "引っかかることなくスルスル"
  },
  {
    "velocity": 1.26,
    "text": "ほどよく空いてて快適"
  },
  {
    "velocity": 1.26,
    "text": "やや急ぎ足の人が多い印象です。"
  },
  {
    "velocity": 1.26,
    "text": "信号変わりそうでちょっと早歩き"
  },
  {
    "velocity": 1.26,
    "text": "わりかし速い"
  },
  {
    "velocity": 1.26,
    "text": "混んでないと歩くの楽だなあ"
  },
  {
    "velocity": 1.26,
    "text": "流れに乗ったら予定より少し早く着いた"
  },
  {
    "velocity": 1.26,
    "text": "すいてる"
  },
  {
    "velocity": 1.26,
    "text": "少し速め"
  },
  {
    "velocity": 1.26,
    "text": "今日は流れが速いな"
  },
  {
    "velocity": 1.26,
    "text": "歩きやすくてつい早足に"
  },
  {
    "velocity": 1.26,
    "text": "人が減ってきてペースが上がった"
  },
  {
    "velocity": 1.26,
    "text": "通路は空いており、やや速いペースで流れています。"
  },
  {
    "velocity": 1.26,
    "text": "スッと通れる"
  },
  {
    "velocity": 1.26,
    "text": "前が詰まってないから気持ちよく歩ける"
  },
  {
    "velocity": 1.26,
    "text": "思いのほかスムーズで拍子抜け"
  },
  {
    "velocity": 1.26,
    "text": "小気味よく進む"
  },
  {
    "velocity": 1.26,
    "text": "いつもより気持ち早く着いた"
  },
  {
    "velocity": 1.26,
    "text": "混雑の時間帯を過ぎたので、足取りも軽くなりました。"
  },
  {
    "velocity": 1.26,
    "text": "ちょっと急ぐか"
  },
  {
    "velocity": 1.26,
    "text": "軽く早歩きできるくらいには空いてる"
  },
  {
    "velocity": 1.26,
    "text": "すっすっと歩ける"
  },
  {
    "velocity": 1.26,
    "text": "待たされることなく、さくっと改札を抜けた"
  },
  {
    "velocity": 1.26,
    "text": "好調"
  },
  {
    "velocity": 1.26,
    "text": "朝が早いぶん人が少なく、普段より少し速く歩けています。"
  },
  {
    "velocity": 1.26,
    "text": "抜かしやすい"
  },
  {
    "velocity": 1.26,
    "text": "ストレスフリーでどんどん進む"
  },
  {
    "velocity": 1.26,
    "text": "ちょっと急いでるけど走るほどじゃない"
  },
  {
    "velocity": 1.26,
    "text": "軽く早歩きしてる程度"
  },
  {
    "velocity": 1.26,
    "text": "普段より少しだけ足が速い"
  },
  {
    "velocity": 1.26,
    "text": "走りはしないけど、いつもより早め"
  },
  {
    "velocity": 1.26,
    "text": "ほんの少し急ぎ足"
  },
  {
    "velocity": 1.62,
    "text": "ガラガラだから走り抜けた"
  },
  {
    "velocity": 1.62,
    "text": "誰もいないから爆速で歩いてる"
  },
  {
    "velocity": 1.62,
    "text": "終電ダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "人っ子ひとりいない地下通路、めちゃくちゃ早く抜けられた"
  },
  {
    "velocity": 1.62,
    "text": "競歩みたいな速度で乗り換え"
  },
  {
    "velocity": 1.62,
    "text": "早朝の駅構内は閑散としており、足早に通り抜けることができました。"
  },
  {
    "velocity": 1.62,
    "text": "みんな歩くの速すぎん？？"
  },
  {
    "velocity": 1.62,
    "text": "貸切状態の通路を全力で駆け抜けた"
  },
  {
    "velocity": 1.62,
    "text": "大股でずんずん、ほぼ駆け足"
  },
  {
    "velocity": 1.62,
    "text": "発車ベル鳴っててホームまで小走り、周りもみんな走ってる"
  },
  {
    "velocity": 1.62,
    "text": "ラッシュ前の通路、全員がほとんど走ってるような速さで流れていく"
  },
  {
    "velocity": 1.62,
    "text": "障害物ゼロ。最速記録更新したかも"
  },
  {
    "velocity": 1.62,
    "text": "空いてて爆速で歩けるの快適すぎる"
  },
  {
    "velocity": 1.62,
    "text": "深夜の商店街は人影もなく、一気に通り抜けた。"
  },
  {
    "velocity": 1.62,
    "text": "遅刻しそうで全力で走った、空いててほんと助かった"
  },
  {
    "velocity": 1.62,
    "text": "びゅんびゅん抜かしていく"
  },
  {
    "velocity": 1.62,
    "text": "現在、通路はたいへん空いており、皆さま駆け足に近い速さで移動されています。"
  },
  {
    "velocity": 1.62,
    "text": "急げ急げ"
  },
  {
    "velocity": 1.62,
    "text": "平日の朝イチに来たら誰もおらず、入口から展示室まで一瞬だった"
  },
  {
    "velocity": 1.62,
    "text": "駆け足"
  },
  {
    "velocity": 1.62,
    "text": "めっちゃ速い"
  },
  {
    "velocity": 1.62,
    "text": "ほぼ全力疾走"
  },
  {
    "velocity": 1.62,
    "text": "ダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "無人の通路を全力疾走"
  },
  {
    "velocity": 1.62,
    "text": "誰にもぶつからずに一直線にダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "走ってる人ばっかり"
  },
  {
    "velocity": 1.62,
    "text": "通路には人影がほとんどなく、あっという間に通り抜けられました。"
  },
  {
    "velocity": 1.62,
    "text": "ガラッガラすぎて、気づいたら走ってた"
  },
  {
    "velocity": 1.62,
    "text": "猛ダッシュで階段かけ上がった"
  },
  {
    "velocity": 1.62,
    "text": "超特急"
  },
  {
    "velocity": 1.62,
    "text": "全員が競歩"
  },
  {
    "velocity": 1.62,
    "text": "人がいなさすぎて逆に不安になるレベル、秒で着いた"
  },
  {
    "velocity": 1.62,
    "text": "一瞬で改札"
  },
  {
    "velocity": 1.62,
    "text": "駆け込み"
  },
  {
    "velocity": 1.62,
    "text": "朝の通勤客の歩く速さ、ほぼ小走りなんよ"
  },
  {
    "velocity": 1.62,
    "text": "すっからかんの構内を駆け抜ける"
  },
  {
    "velocity": 1.62,
    "text": "現在、構内はたいへん空いており、非常に速やかにご移動いただけます。"
  },
  {
    "velocity": 1.62,
    "text": "びゅーん"
  },
  {
    "velocity": 1.62,
    "text": "乗り遅れる！！走れ！"
  },
  {
    "velocity": 1.62,
    "text": "遮るものが何もないから全速力"
  },
  {
    "velocity": 1.62,
    "text": "飛ぶように歩く人たち"
  },
  {
    "velocity": 1.62,
    "text": "始発前の駅前、人はまばらどころかほぼゼロ。ぐんぐん歩ける"
  },
  {
    "velocity": 1.62,
    "text": "爆速"
  },
  {
    "velocity": 1.62,
    "text": "ノンストップで駆け抜けた"
  },
  {
    "velocity": 1.62,
    "text": "全力疾走"
  },
  {
    "velocity": 1.62,
    "text": "こんなに空いてるの初めて見た、ほぼ走ってる速度で歩けた"
  },
  {
    "velocity": 1.62,
    "text": "がらんとしたコンコースを大急ぎで横切る"
  },
  {
    "velocity": 1.62,
    "text": "猛スピード"
  },
  {
    "velocity": 1.62,
    "text": "みんな殺気立った速さで歩いてて怖い"
  },
  {
    "velocity": 1.62,
    "text": "閑散とした道を小走りで一気に"
  },
  {
    "velocity": 1.62,
    "text": "台風の日で外に誰もおらず、普段の人混みが嘘のように一気に歩けた。"
  },
  {
    "velocity": 1.62,
    "text": "息切れするくらい走った"
  },
  {
    "velocity": 1.62,
    "text": "独走状態でぶっちぎりで走ってる"
  },
  {
    "velocity": 1.62,
    "text": "ほぼ走り"
  },
  {
    "velocity": 1.62,
    "text": "雨が降り出して、みんな一斉に走り出した"
  },
  {
    "velocity": 1.62,
    "text": "空っぽの歩道を飛ばす"
  },
  {
    "velocity": 1.62,
    "text": "追い抜く相手すらいないまま全力で走った"
  },
  {
    "velocity": 1.62,
    "text": "風のように去っていく人々"
  },
  {
    "velocity": 1.62,
    "text": "最速"
  },
  {
    "velocity": 1.62,
    "text": "閉館間際で館内に人はほとんどおらず、出口まで小走りで一気に抜けました。"
  },
  {
    "velocity": 1.62,
    "text": "走ってる"
  },
  {
    "velocity": 1.62,
    "text": "超速い"
  },
  {
    "velocity": 1.62,
    "text": "全速力"
  },
  {
    "velocity": 1.62,
    "text": "人が全然いない！走れる！"
  },
  {
    "velocity": 1.62,
    "text": "誰ともすれ違わないまま、駅まで一気に走ってきた"
  },
  {
    "velocity": 1.62,
    "text": "人影のない通路を、ほとんど走るように通り抜けました。"
  },
  {
    "velocity": 1.62,
    "text": "バタバタと走り抜ける人たち"
  },
  {
    "velocity": 1.62,
    "text": "ダッシュで滑り込みセーフ"
  },
  {
    "velocity": 1.62,
    "text": "もぬけの殻の構内を猛ダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "歩くスピードが異常に速い集団にのまれて、こっちまで小走り"
  },
  {
    "velocity": 1.62,
    "text": "がらがらの通路を全力で駆ける"
  },
  {
    "velocity": 1.62,
    "text": "高速移動"
  },
  {
    "velocity": 1.62,
    "text": "ホームまで一気に駆け下りた"
  },
  {
    "velocity": 1.62,
    "text": "周囲に歩行者はほぼ見当たらず、きわめて速く通行できる状態です。"
  },
  {
    "velocity": 1.62,
    "text": "疾走"
  },
  {
    "velocity": 1.62,
    "text": "間に合え〜〜って全員走ってる"
  },
  {
    "velocity": 1.62,
    "text": "広い通路を独り占め、ぶっ飛ばして歩いた"
  },
  {
    "velocity": 1.62,
    "text": "あっという間に通り抜けた、誰もいないから"
  },
  {
    "velocity": 1.62,
    "text": "目にも止まらぬ速さで駆け抜ける"
  },
  {
    "velocity": 1.62,
    "text": "朝練に遅れそうで、誰もいない道をひたすら走った"
  },
  {
    "velocity": 1.62,
    "text": "遅刻確定しそうだったから駅まで全力で走った"
  },
  {
    "velocity": 1.62,
    "text": "乗り換え時間ぎりぎりで猛ダッシュ"
  },
  {
    "velocity": 1.62,
    "text": "急いでたからエスカレーター横の階段を駆け上がった"
  },
  {
    "velocity": 1.62,
    "text": "間に合わなそうで小走りどころか本気で走った"
  },
  {
    "velocity": 1.62,
    "text": "発車まであと少し、みんな一斉にホームへ駆けていく"
  },
  {
    "velocity": 1.62,
    "text": "寝坊して家から駅まで走りっぱなし"
  },
  {
    "velocity": 1.62,
    "text": "一度も止まらずに改札まで駆け抜けた"
  },
  {
    "velocity": 1.62,
    "text": "誰にも邪魔されずに全速力で走れた"
  },
  {
    "velocity": 1.62,
    "text": "減速することなく一気に通過"
  },
  {
    "velocity": 1.62,
    "text": "信号ひとつ引っかからずに走り切った"
  },
  {
    "velocity": 1.62,
    "text": "自転車並みのスピードで歩いてる人がいる"
  },
  {
    "velocity": 1.62,
    "text": "走ってる人が多すぎて風を感じる"
  },
  {
    "velocity": 1.62,
    "text": "ほぼジョギング"
  },
  {
    "velocity": 1.62,
    "text": "全員駆け足"
  },
  {
    "velocity": 1.62,
    "text": "もはや歩きじゃなくて走り"
  },
  {
    "velocity": 1.62,
    "text": "会場から出た瞬間、みんな駅に向かって走り出した"
  },
  {
    "velocity": 1.62,
    "text": "足が勝手に駆け出すくらい急いでる"
  },
  {
    "velocity": 1.62,
    "text": "息が上がるほどのダッシュでなんとか滑り込んだ"
  },
  {
    "velocity": 1.62,
    "text": "鬼のような速さで通勤客が通り過ぎていく"
  },
  {
    "velocity": 1.62,
    "text": "気づいたら走ってた、それくらい急いでた"
  },
  {
    "velocity": null,
    "text": "ラーメン食べたい"
  },
  {
    "velocity": null,
    "text": "明日の線形代数の小テスト、何も勉強してない"
  },
  {
    "velocity": null,
    "text": "猫"
  },
  {
    "velocity": null,
    "text": "昨日の試合、最後の逆転ゴールは鳥肌ものでした。"
  },
  {
    "velocity": null,
    "text": "洗濯物干すの忘れてた"
  },
  {
    "velocity": null,
    "text": "新しいイヤホン届いた！音がぜんぜん違う"
  },
  {
    "velocity": null,
    "text": "眠い"
  },
  {
    "velocity": null,
    "text": "今年の冬は例年より気温が低くなる見込みだそうです。"
  },
  {
    "velocity": null,
    "text": "バイトの給料日まであと3日"
  },
  {
    "velocity": null,
    "text": "カレーは二日目がうまい"
  },
  {
    "velocity": null,
    "text": "推しの新曲が良すぎて無限リピートしてる"
  },
  {
    "velocity": null,
    "text": "図書館で借りた本、返却期限すぎてた…"
  },
  {
    "velocity": null,
    "text": "抹茶ラテ"
  },
  {
    "velocity": null,
    "text": "髪切ったのに誰にも気づかれない"
  },
  {
    "velocity": null,
    "text": "来週の会議資料は木曜までに共有いたします。"
  },
  {
    "velocity": null,
    "text": "筋肉痛でペットボトルのふたが開かない"
  },
  {
    "velocity": null,
    "text": "映画の続編、正直一作目のほうが好きだったな"
  },
  {
    "velocity": null,
    "text": "実家から梨が大量に届いた"
  },
  {
    "velocity": null,
    "text": "充電器どこ"
  },
  {
    "velocity": null,
    "text": "久しぶりに自炊。豚の生姜焼きとみそ汁、我ながら上出来"
  },
  {
    "velocity": null,
    "text": "おなかすいた"
  },
  {
    "velocity": null,
    "text": "餃子"
  },
  {
    "velocity": null,
    "text": "レポートの参考文献リスト作るのが一番めんどい"
  },
  {
    "velocity": null,
    "text": "今朝のコーヒー、豆を変えたら酸味が強くなった気がします。"
  },
  {
    "velocity": null,
    "text": "うちの犬がソファを占領してる"
  },
  {
    "velocity": null,
    "text": "テニスのガット張り替えた"
  },
  {
    "velocity": null,
    "text": "月がきれい"
  },
  {
    "velocity": null,
    "text": "明日は燃えるゴミの日"
  },
  {
    "velocity": null,
    "text": "積ん読がまた増えた"
  },
  {
    "velocity": null,
    "text": "新作ゲームのストーリーが思ったより重い"
  },
  {
    "velocity": null,
    "text": "アイス"
  },
  {
    "velocity": null,
    "text": "冷蔵庫の卵、賞味期限いつだっけ"
  },
  {
    "velocity": null,
    "text": "本日の日替わり定食はサバの味噌煮です。"
  },
  {
    "velocity": null,
    "text": "歯医者の予約とらなきゃ"
  },
  {
    "velocity": null,
    "text": "ギターのFコードがいまだに押さえられない"
  },
  {
    "velocity": null,
    "text": "虹出てる！"
  },
  {
    "velocity": null,
    "text": "英単語がまったく頭に入ってこない夜"
  },
  {
    "velocity": null,
    "text": "観葉植物に新しい葉っぱが出てきてうれしい"
  },
  {
    "velocity": null,
    "text": "部屋の片付けをしていたら昔のアルバムが出てきて、つい見入ってしまいました。"
  },
  {
    "velocity": null,
    "text": "ポイントカード忘れた"
  },
  {
    "velocity": null,
    "text": "この漫画、最終回で泣いた"
  },
  {
    "velocity": null,
    "text": "プリンは固め派"
  },
  {
    "velocity": null,
    "text": "来月の家賃振り込まないと"
  },
  {
    "velocity": null,
    "text": "微分方程式わからん"
  },
  {
    "velocity": null,
    "text": "ホームラン！！！"
  },
  {
    "velocity": null,
    "text": "新しく買ったフライパン、焦げつかなくて感動してる"
  },
  {
    "velocity": null,
    "text": "祖母の作る煮物の味がどうしても再現できない"
  },
  {
    "velocity": null,
    "text": "花粉"
  },
  {
    "velocity": null,
    "text": "面接の結果は一週間以内にメールでご連絡いたします。"
  },
  {
    "velocity": null,
    "text": "日焼け止め塗り忘れた"
  },
  {
    "velocity": null,
    "text": "深夜のカップ麺は罪の味"
  },
  {
    "velocity": null,
    "text": "キーボードの打鍵音が好きすぎる"
  },
  {
    "velocity": null,
    "text": "今年こそ簿記の資格を取りたいと思っている。"
  },
  {
    "velocity": null,
    "text": "靴下が片方ない"
  },
  {
    "velocity": null,
    "text": "隣の部屋からピアノの音が聞こえる"
  },
  {
    "velocity": null,
    "text": "卒論のテーマまだ決まってない、どうしよう"
  },
  {
    "velocity": null,
    "text": "お風呂わいた"
  },
  {
    "velocity": null,
    "text": "このドラマ、主題歌がいいんだよな"
  },
  {
    "velocity": null,
    "text": "たこ焼きパーティーしたい"
  },
  {
    "velocity": null,
    "text": "寒い"
  },
  {
    "velocity": null,
    "text": "からあげ"
  },
  {
    "velocity": null,
    "text": "締め切り明日なのに一文字も書いてない"
  },
  {
    "velocity": null,
    "text": "今日のお弁当、卵焼きがうまく巻けた"
  },
  {
    "velocity": null,
    "text": "新しいスニーカーほしい"
  },
  {
    "velocity": null,
    "text": "昨夜の月食、雲で見えませんでした。"
  },
  {
    "velocity": null,
    "text": "将棋のルール覚えたい"
  },
  {
    "velocity": null,
    "text": "眼鏡どこ置いたっけ"
  },
  {
    "velocity": null,
    "text": "統計の課題、標準偏差の意味がようやくわかった"
  },
  {
    "velocity": null,
    "text": "推しが尊い"
  },
  {
    "velocity": null,
    "text": "今年の梅干しは塩加減がちょうどよく仕上がりました。"
  },
  {
    "velocity": null,
    "text": "水泳のあとのアイスは格別"
  },
  {
    "velocity": null,
    "text": "あくびが止まらない"
  },
  {
    "velocity": null,
    "text": "プレゼンのスライド、フォントで悩んで一日終わった"
  },
  {
    "velocity": null,
    "text": "みかん"
  },
  {
    "velocity": null,
    "text": "先日はお忙しい中お時間をいただき、誠にありがとうございました。"
  },
  {
    "velocity": null,
    "text": "弟がまた勝手に俺のプリン食べた"
  },
  {
    "velocity": null,
    "text": "編み物始めてみたけど肩こりがすごい"
  },
  {
    "velocity": null,
    "text": "星がよく見える夜"
  },
  {
    "velocity": null,
    "text": "パスワード忘れてログインできない"
  },
  {
    "velocity": null,
    "text": "麦茶を作り置きする季節になった"
  }
]